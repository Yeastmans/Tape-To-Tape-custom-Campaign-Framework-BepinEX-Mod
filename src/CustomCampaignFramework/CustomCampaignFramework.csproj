<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CustomCampaignFramework</AssemblyName>
    <RootNamespace>EndlessMode</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Try the live BepInEx interop folder first; fall back to our committed backup
         if the installer wiped it. Rebuilds no longer require relaunching the game. -->
    <InteropLive>C:\Steam\steamapps\common\Tape to Tape\BepInEx\interop</InteropLive>
    <InteropBackup>$(MSBuildThisFileDirectory)..\..\interop_backup</InteropBackup>
    <InteropDir Condition="Exists('$(InteropLive)\Assembly-CSharp.dll')">$(InteropLive)</InteropDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(InteropBackup)</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>C:\Steam\steamapps\common\Tape to Tape\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>C:\Steam\steamapps\common\Tape to Tape\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>C:\Steam\steamapps\common\Tape to Tape\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>C:\Steam\steamapps\common\Tape to Tape\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(InteropDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(InteropDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BishopGames.UIModule">
      <HintPath>$(InteropDir)\BishopGames.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BishopGames.Module">
      <HintPath>$(InteropDir)\BishopGames.Module.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MainScriptsAssembly">
      <HintPath>$(InteropDir)\MainScriptsAssembly.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="I2_assembly">
      <HintPath>$(InteropDir)\I2_assembly.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
