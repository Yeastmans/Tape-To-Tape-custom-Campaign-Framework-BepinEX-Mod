<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds Campaign Studio's game artwork from the player's own Tape to Tape install, so no game art ships with the Studio. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameArt</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT. Reads Unity 6 bundles, decodes textures, and deserializes IL2CPP MonoBehaviours. -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="AssetsTools.NET.Cpp2IL" Version="3.0.4" />
    <!-- Pinned: pre-release.19 is the newest LibCpp2IL that both reads Unity 6 metadata (v31) and still
         matches AssetsTools.NET.Cpp2IL 3.0.4 (pre-release.20+ changed LibCpp2IlMain.MetadataVersion). -->
    <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-pre-release.19" />
    <!-- Same SkiaSharp as Avalonia 11.3.22. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CampaignCore/CampaignCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/reward-pools/reward-families.tsv" LogicalName="GameArt.RewardFamilies.tsv" />
    <EmbeddedResource Include="../../assets/reward-pools/reward_catalog.tsv" LogicalName="GameArt.RewardCatalog.tsv" />
    <!-- Geometry and name mappings from the game's Spine skeletons (numbers, no artwork), made by tools/export_game_art_maps.ps1. -->
    <EmbeddedResource Include="../../assets/game-art-maps/*.json" LogicalName="GameArt.Maps.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
